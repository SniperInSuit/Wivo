{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node"]
  },
  "include": [
    "electron.vite.config.*", "config/testCopyEnv.ts", "src/main/**/*", "src/preload/**/*", "src/types/**/*",
    "shared/license/token.ts", "shared/privacy/scrub.ts"
  ]
}
