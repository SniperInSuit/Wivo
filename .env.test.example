# Wivo test mode: `npm run dev:test` runs the desktop app against the TEST COPY.
# Paste in the test copy's project URL and anon (public) key, nothing else.
# NEVER a service_role key, NEVER an access token (sbp_…). This file is in .gitignore.
# Left empty, or pointed at production, the app refuses to connect and shows a red banner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
